#Область ДобавленныеПроцедуыИКоманды_НеПоставщиком
// {{ Смирнов П.В.: Добавленные по условию задачи процедуры и команда

&НаКлиенте
Процедура ЭлементДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	
	ЗадатьВопросПользователюАсинх();
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗадатьВопросПользователюАсинх()
	
	Если Не ЗначениеЗаполнено(Объект.Товары) И Не ЗначениеЗаполнено(Объект.Услуги) Тогда
		Возврат;
		
	Иначе
		Обещание = ВопросАсинх("Вы желаете пересчитать цены с согласованной скидкой",РежимДиалогаВопрос.ДаНет);
		ОтветНаВопрос = Ждать Обещание;
		
	КонецЕсли;
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Возврат;
	ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицыДокумента();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ДЗ_РассчетСоСкидкой(Команда)
	
	ЗаполнитьТаблицыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицыДокумента()
	
	Для Каждого СтрокаТовары Из Объект.Товары Цикл
		РассчитатьСуммуСтроки(СтрокаТовары);
		
	КонецЦикла;
	
	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл
		РассчитатьСуммуСтроки(СтрокаУслуги);
		
	КонецЦикла;
КонецПроцедуры

// }}
#КонецОбласти

